{
  "build": {
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_CATALOG_URL": "https://veinpsycoo.github.io/sole-radar/api/catalog.json"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_CATALOG_URL": "https://veinpsycoo.github.io/sole-radar/api/catalog.json"
      }
    },
    "simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_CATALOG_URL": "https://veinpsycoo.github.io/sole-radar/api/catalog.json"
      }
    }
  },
  "submit": {
    "production": {}
  },
  "cli": {
    "appVersionSource": "remote"
  }
}